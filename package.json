{
  "name": "rank",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, auditable, transparent college football rankings derived from a game graph.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch": "tsx scripts/fetch-cfbd.ts",
    "demo": "tsx scripts/make-demo.ts",
    "compute": "tsx scripts/compute.ts",
    "neural:export": "OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 python scripts/export-neural.py",
    "audit-neural": "tsx scripts/audit-neural.ts",
    "audit-springs": "tsx scripts/audit-springs.ts",
    "verify": "tsx scripts/verify.ts",
    "audit-win-quality": "tsx scripts/audit-win-quality.ts",
    "backtest": "tsx scripts/backtest.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "project-backtest": "tsx scripts/project-backtest.ts",
    "fetch-plays": "tsx scripts/fetch-plays.ts"
  },
  "dependencies": {
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.3",
    "hyparquet": "1.31.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
